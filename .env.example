# Daynest — environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Supabase project URL and the public anon / publishable key
# (Supabase Dashboard -> Project Settings -> API).
# Leave both empty to run Daynest in local-only mode (no accounts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the service_role / secret key in any VITE_ variable:
# VITE_ variables are bundled into the website and visible to everyone.
